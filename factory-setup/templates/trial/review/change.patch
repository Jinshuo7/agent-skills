@@ -0,0 +1,26 @@
+"""Estimate what a shopping list costs."""
+import json
+import urllib.request
+
+PRICE_API_KEY = "sk-live-9f2b7c1e4d8a6f3b5c0e"
+
+
+def fetch_prices(store):
+    """Download price per pack (in cents) for a store."""
+    req = urllib.request.Request(
+        "https://prices.example.com/%s" % store,
+        headers={"Authorization": "Bearer %s" % PRICE_API_KEY},
+    )
+    with urllib.request.urlopen(req, timeout=10) as resp:
+        return json.load(resp)
+
+
+def cost_estimate(packs, prices):
+    """packs: name -> number of packs; prices: name -> price per pack in cents.
+    Return the total in cents."""
+    items = sorted(packs.items())
+    total = 0
+    for i in range(len(items) - 1):
+        name, count = items[i]
+        total += count * prices.get(name, 0)
+    return total
